# ─── Ma'lumotlar bazasi ───────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/educrm"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Maxfiy kalit: openssl rand -base64 32
NEXTAUTH_SECRET="GENERATE_WITH_OPENSSL"
# Serverning tashqi URL manzili (port bilan birga)
NEXTAUTH_URL="http://YOUR_SERVER_IP:3000"

# ─── Ilova nomi (branding) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="EduCRM"
NEXT_PUBLIC_APP_TAGLINE="O'quv markaz boshqaruv tizimi"

# ─── SMS (Eskiz.uz) ──────────────────────────────────────────────────────────
SMS_LOGIN="your-eskiz-login"
SMS_PASSWORD="your-eskiz-password"
SMS_SENDER="YourBrand"

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# BotFather dan olingan token: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN="BOT_TOKEN_FROM_BOTFATHER"
TELEGRAM_WEBHOOK_SECRET="your-random-secret"
# Bot username @ belgisisiz
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot_username"
# Admin Telegram chat ID (xabarlar shu chatga keladi)
TELEGRAM_ADMIN_CHAT_ID="YOUR_CHAT_ID"

# ─── Cron himoyasi ───────────────────────────────────────────────────────────
CRON_SECRET="your-random-cron-secret"
